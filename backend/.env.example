# Copy to .env and edit. Everything is optional.
DEEP_CHECKS=1            # live domain age / redirects / SSL checks (needs internet). Use 0 when offline.
FETCH_WEBSITES=1         # download the page when a website address is given
CORS_ORIGINS=*           # in production: https://your-site.example
BLACKLIST_MIN_REPORTS=2  # reports needed before an identifier is blacklisted
MAX_APK_MB=60
# ANTHROPIC_API_KEY=sk-ant-...   # turns the "Ask AI" panel into an LLM assistant; without it a rule-based assistant is used
# ASSISTANT_MODEL=claude-sonnet-5-5
